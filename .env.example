NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_your-key
SUPABASE_SERVICE_ROLE_KEY=sb_secret_your-key
GOOGLE_CLOUD_PROJECT=your-google-cloud-project-id
GOOGLE_CLOUD_LOCATION=global
# Vercel: paste the complete service-account JSON as a single encrypted environment variable.
# Do not set GOOGLE_APPLICATION_CREDENTIALS on Vercel because it expects a local file path.
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"your-google-cloud-project-id"}
CLOUD_RUN_SCRAPER_PROJECT=riley-ai-api
CLOUD_RUN_SCRAPER_REGION=europe-west1
CLOUD_RUN_SCRAPER_JOB=nexus-lead-scraper
# Local development only; prefer an attached service account when deployed.
GOOGLE_APPLICATION_CREDENTIALS=C:\\path\\to\\vertex-service-account.json
GEMINI_RESEARCH_MODEL=gemini-2.5-flash
GEMINI_LEAD_MODEL=gemini-2.5-flash-lite
GEMINI_FAST_MODEL=gemini-2.5-flash
GEMINI_PRO_MODEL=gemini-2.5-pro
# LOCAL GOOGLE MAPS SCRAPER
MAPS_SCRAPER_CONCURRENCY=4
MAPS_SCRAPER_MAX_SCROLLS=600
MAPS_SCRAPER_SCROLL_DELAY_MS=550
MAPS_SCRAPER_DETAIL_RETRIES=2
MAPS_SCRAPER_SEARCH_SHARDS=5
MAPS_SCRAPER_MAX_LINKS_PER_SHARD=2000
MAPS_SCRAPER_MULTI_AREAS=6
# VERCEL LEAD DISCOVERY
# The Vercel route starts this Nexus-owned Cloud Run Job, which writes leads to Supabase.
# The Google service account in GOOGLE_SERVICE_ACCOUNT_JSON needs Cloud Run job execution permissions.
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
AZURE_TENANT_ID=your-azure-tenant-id
AZURE_CLIENT_ID=your-azure-client-id
AZURE_CLIENT_SECRET=your-azure-client-secret
GITHUB_PERSONAL_ACCESS_TOKEN=your-github-token
SCREENSHOT_ENDPOINT=https://your-cloud-run-puppeteer-service-url
GOOGLE_SHEETS_AUDIT_SPREADSHEET_ID=your-google-sheet-id
GOOGLE_SHEETS_AUDIT_RANGE=Website Audits!A:H

# APPLICATION
# Vercel production URL, without a trailing slash. This is used for OAuth callbacks.
NEXT_PUBLIC_APP_URL=https://your-project.vercel.app
OAUTH_STATE_SECRET=replace-with-a-long-random-secret
